{
  "Print": {
    // Порт, на який шле Android-застосунок. Брандмауер відкриває install.ps1.
    "Port": 8631,
    // Ім'я принтера в Windows. Порожньо = перший принтер, у якого в назві чи
    // в імені спільного доступу є "MF3010", інакше принтер за замовчуванням.
    "Printer": "",
    // Якщо не порожній — застосунок має надсилати той самий ключ (поле «Ключ» у налаштуваннях).
    "Token": "",
    // Роздільність рендеру PDF. 300 — чітко й не жере пам'ять; 600 — як у принтера, але повільніше.
    "RenderDpi": 300,
    // Найбільший файл, МБ.
    "MaxUploadMb": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
